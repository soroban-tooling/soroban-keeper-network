# ──────────────────────────────────────────────────────────────
# Soroban Keeper Bot — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# ──────────────────────────────────────────────────────────────

# Network: testnet | futurenet | mainnet
NETWORK=testnet

# Your keeper's Stellar secret key (starts with S...)
# Fund this account on testnet: https://laboratory.stellar.org/#account-creator
KEEPER_SECRET_KEY=SXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# The deployed KeeperRegistry contract ID (starts with C...)
REGISTRY_CONTRACT_ID=CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# How often to poll for new tasks (milliseconds, integer, >= 1000)
POLL_INTERVAL_MS=10000

# Minimum accumulated rewards before auto-withdrawal (integer, in stroops)
# 1 XLM = 10_000_000 stroops.
WITHDRAW_THRESHOLD=10000000

# Maximum tasks to process per poll round (integer, >= 1)
MAX_TASKS_PER_ROUND=5

# Retry policy for transient RPC/network errors
MAX_RETRIES=3 # (integer, >= 0)
RETRY_BASE_MS=500 # (integer, > 0)

# Call expire_task on past-deadline tasks to refund owners (public good).
# Set to false to only spend fees on tasks you can earn rewards from.
EXPIRE_STALE_TASKS=true

# Minimum net profit margin (in stroops) required to claim a task.
# Tasks whose reward minus estimated fees (claim + execute + verifier)
# does not exceed this margin will be skipped. Defaults to 0.
MIN_PROFIT_MARGIN_STROOPS=0

# Set to true to run one round and exit (for cron or serverless).
# Overrides the default polling behavior.
# RUN_ONCE=true

# DEVELOPMENT ONLY. When true, and no real executor is registered for a
# task's task_type in EXECUTORS (see index.js), the bot fabricates a
# synthetic proof instead of skipping the task. This does NOT perform any
# real off-chain work — the resulting execute_task submission claims a
# reward for work that was never done. Never enable this against a real
# deployment; it exists only so the bot's daemon loop can be exercised
# end-to-end (e.g. on testnet) before real executors are written. Defaults
# to false, so an unhandled task type is refused rather than faked.
# SIMULATE_EXECUTION=true
