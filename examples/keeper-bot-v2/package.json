{
  "name": "soroban-keeper-bot-v2",
  "version": "0.2.0",
  "description": "Production-grade keeper bot for the Soroban Keeper Network \u2014 aimed at operators competing for rewards (see examples/keeper-bot for the beginner-friendly single-file version).",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "node init && tsc -p tsconfig.json",
    "start": "node init && node dist/index.js",
    "test": "vitest run && node --test test/*.test.js",
    "lint": "eslint ."
  },
  "keywords": [
    "soroban",
    "stellar",
    "keeper",
    "automation",
    "defi"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@soroban-keeper-network/sdk": "file:../../packages/sdk-ts",
    "@stellar/stellar-sdk": "^16.2.0",
    "dotenv": "^17.4.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@typescript-eslint/eslint-plugin": "^8.19.0",
    "@typescript-eslint/parser": "^8.19.0",
    "eslint": "^9.17.0",
    "globals": "^17.8.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
