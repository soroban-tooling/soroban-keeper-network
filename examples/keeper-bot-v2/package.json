{
  "name": "soroban-keeper-bot-v2",
  "version": "0.1.0",
  "description": "Advanced off-chain keeper bot for the Soroban Keeper Network with profitability prioritization, concurrency, and persistent state",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./loop": {
      "types": "./dist/loop.d.ts",
      "import": "./dist/loop.js"
    },
    "./ranking": {
      "types": "./dist/ranking.d.ts",
      "import": "./dist/ranking.js"
    },
    "./profitability": {
      "types": "./dist/profitability.d.ts",
      "import": "./dist/profitability.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "soroban",
    "stellar",
    "keeper",
    "automation",
    "defi",
    "profitability",
    "bot"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@soroban-keeper-network/sdk": "file:../../packages/sdk-ts",
    "@stellar/stellar-sdk": "^16.2.0",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.19.0",
    "@typescript-eslint/parser": "^8.19.0",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
