{
  "name": "soroban-keeper-bot-v2",
  "version": "0.1.0",
  "description": "Production-grade keeper bot for the Soroban Keeper Network — aimed at operators competing for rewards, not at newcomers (see examples/keeper-bot for the beginner-friendly single-file version).",
  "main": "src/index.js",
  "scripts": {
    "test": "node --test",
    "lint": "eslint ."
  "description": "Production-grade keeper bot for the Soroban Keeper Network with profitability, adaptive fees, persistence, concurrency, metrics, and alerting",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./loop": {
      "types": "./dist/loop.d.ts",
      "import": "./dist/loop.js"
    },
    "./ranking": {
      "types": "./dist/ranking.d.ts",
      "import": "./dist/ranking.js"
    },
    "./profitability": {
      "types": "./dist/profitability.d.ts",
      "import": "./dist/profitability.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist"
  "version": "0.2.0",
  "description": "Production-grade concurrent keeper bot v2 for the Soroban Keeper Network",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/index.js",
    "test": "tsc && node --test dist/test/**/*.test.js",
    "lint": "eslint src test"
  },
  "keywords": [
    "soroban",
    "stellar",
    "keeper",
    "automation",
    "defi"
    "defi",
    "profitability",
    "adaptive-fees",
    "alerting",
    "metrics",
    "production",
    "bot"
    "v2"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@soroban-keeper-network/sdk": "file:../../packages/sdk-ts",
    "@stellar/stellar-sdk": "^16.2.0",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "globals": "^17.8.0"
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.19.0",
    "@typescript-eslint/parser": "^8.19.0",
    "@vitest/ui": "^1.0.0",
    "eslint": "^9.17.0",
    "globals": "^17.8.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^7.0.0",
    "vitest": "^2.1.8"
    "dotenv": "^17.4.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@typescript-eslint/eslint-plugin": "^8.19.0",
    "@typescript-eslint/parser": "^8.19.0",
    "eslint": "^9.17.0",
    "globals": "^17.8.0",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
