# Environment configuration for keeper-bot-v2 deployment (docker-compose).
#
# SECURITY: This file contains PLACEHOLDER VALUES only.
# Before deployment:
#   1. Copy this file to .env
#   2. Replace placeholder values with your actual configuration
#   3. Ensure .env is added to .gitignore (NEVER commit real secrets)
#   4. Restrict file permissions: chmod 600 .env
#
# All secrets (KEEPER_SECRET_KEY, DB_PASSWORD) are injected at runtime
# and are never baked into the container image.

# ═══════════════════════════════════════════════════════════════════════════
# REQUIRED: Stellar & Keeper Configuration
# ═══════════════════════════════════════════════════════════════════════════

# Keeper's Stellar account secret key (starts with S).
# How to get:
#   1. Generate a new keypair: https://laboratory.stellar.org/#account-creator
#   2. Create the account on testnet: https://laboratory.stellar.org/#account-creator
#   3. Or use an existing funded account's secret key
# Security: Keep this secret. Never commit to version control.
# Example format: SBVQ7AYDKXQY5MNICBVIIXKB2C2Z4AIDP7YWJJVGFYVYHJSHH7XFBID
KEEPER_SECRET_KEY=SBXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Deployed KeeperRegistry contract ID (starts with C).
# How to get:
#   1. From the deployment outputs when keeper-registry was deployed
#   2. Or query the network: $ soroban contract list --network testnet
# Example format: CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAWHF
REGISTRY_CONTRACT_ID=CAXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Stellar network (testnet, futurenet, or mainnet).
# testnet  — for development/testing (recommended)
# futurenet — for protocol feature testing
# mainnet  — production (real XLM, real stakes)
NETWORK=testnet

# ═══════════════════════════════════════════════════════════════════════════
# REQUIRED: Database Configuration
# ═══════════════════════════════════════════════════════════════════════════

# PostgreSQL database credentials and connection details.
# These are used by the docker-compose service to initialize the database
# and by keeper-bot to connect and persist state.
#
# The DATABASE_URL environment variable in the bot service is auto-constructed as:
#   postgresql://{DB_USER}:{DB_PASSWORD}@postgres:5432/{DB_NAME}
# where 'postgres' is the hostname of the PostgreSQL service within the Docker network.

# Database user (created by PostgreSQL container)
DB_USER=keeper

# Database password (SECRET — keep safe, never commit)
# Generate a strong password: `openssl rand -base64 32`
# Example: bGVhZHNVMktNNGZCMjN5c2tXa2haaWFJN0d5dGdlMTk=
DB_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# Database name (created by PostgreSQL container)
DB_NAME=keeper_bot

# ═══════════════════════════════════════════════════════════════════════════
# OPTIONAL: Keeper Bot Operational Configuration
# ═══════════════════════════════════════════════════════════════════════════

# How often to poll for new tasks (milliseconds).
# Decrease for faster task detection; increase to reduce RPC load.
# Default: 10000 (10 seconds)
POLL_INTERVAL_MS=10000

# Minimum accumulated rewards before automatic withdrawal (stroops).
# 1 XLM = 10,000,000 stroops.
# Set to 0 to disable auto-withdrawal; manage withdrawal manually instead.
# Default: 10000000 (1 XLM)
WITHDRAW_THRESHOLD=10000000

# Maximum tasks to process in a single polling round.
# Prevents resource exhaustion; limits concurrent claims per round.
# Default: 5
MAX_TASKS_PER_ROUND=5

# Retry attempts for transient errors (RPC timeouts, etc).
# Permanent errors (invalid signature, authorization, already claimed) are not retried.
# Default: 3
MAX_RETRIES=3

# Base delay for exponential backoff during retries (milliseconds).
# Actual delay = base * (2 ^ attempt) + random jitter.
# Default: 500
RETRY_BASE_MS=500

# Whether to call expire_task on tasks past their deadline.
# true  — proactively expire stale tasks (reclaim the lock, help the network)
# false — ignore expired tasks (minimize gas spend)
# Default: true
EXPIRE_STALE_TASKS=true

# Minimum profit margin required to claim a task (stroops).
# Only claim tasks where (task.reward - estimated_gas) >= this value.
# Prevents claiming marginally profitable or unprofitable tasks.
# Default: 0 (claim any claimable task)
MIN_PROFIT_MARGIN_STROOPS=0

# ═══════════════════════════════════════════════════════════════════════════
# OPTIONAL: Development Configuration
# ═══════════════════════════════════════════════════════════════════════════

# [DEVELOPMENT ONLY] Simulate task execution without a real executor.
# true  — fabricate synthetic proofs instead of calling the executor
# false — call the registered off-chain executor (or fail if none exists)
# Default: false
# WARNING: Do not enable in production; only for testing without executors.
SIMULATE_EXECUTION=false

# One-shot execution mode (suitable for cron or serverless).
# true  — run a single round then exit with code 0 (success) or 1 (failure)
# false — run continuously in daemon mode, polling every POLL_INTERVAL_MS
# Default: false
RUN_ONCE=false
