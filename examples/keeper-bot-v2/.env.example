# Soroban Keeper Network - Keeper Bot v2
# Configuration for adaptive fee submission

# ============================================================================
# Adaptive Fee Configuration
# ============================================================================

# Maximum fee in stroops the operator will ever pay.
# The adaptive fee module will never submit a transaction with a fee exceeding
# this value, regardless of network congestion.
# Recommended: 10000 stroops for normal operations.
# Default: 10000
FEE_CEILING_STROOPS=10000

# Target fee percentile from recent network statistics.
# p10  = Pay more than 10% of recent transactions (ultra-low cost, risky)
# p50  = Pay more than 50% (median fee, moderate inclusion probability)
# p90  = Pay more than 90% (high inclusion probability, recommended)
# p99  = Pay more than 99% (extreme inclusion priority, expensive)
# Default: p90
FEE_PERCENTILE=p90

# Multiplier applied to the selected percentile fee.
# 1.0  = Exact percentile fee from network stats
# 1.1  = 10% above percentile (balance of inclusion and cost)
# 1.5+ = Aggressive fee bumping for high-priority transactions
# Default: 1.1
FEE_MULTIPLIER=1.1

# ============================================================================
# Soroban RPC Configuration
# ============================================================================

# Soroban RPC server URL for querying network conditions and submitting transactions
# Examples:
#   Testnet:  https://soroban-testnet.stellar.org
#   Mainnet:  https://soroban-mainnet.stellar.org
#   Local:    http://localhost:8000
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# ============================================================================
# Network Configuration
# ============================================================================

# Stellar network to target
# Options: testnet, mainnet, standalone
# Default: testnet
NETWORK=testnet

# ============================================================================
# Keeper Configuration (TODO: expand as keeper-bot-v2 features are added)
# ============================================================================

# Stellar account secret key for signing transactions
# Format: A 56-character base32 string starting with S
# WARNING: Never commit this to version control. Use a secrets manager in production.
KEEPER_SECRET_KEY=

# Account ID for the keeper (optional, used for display/validation)
KEEPER_ACCOUNT_ID=

# Maximum concurrent task executions per round
# Default: 1
MAX_CONCURRENT_TASKS=1
