# ──────────────────────────────────────────────────────────────────────────────
# Soroban Keeper Bot v2 — environment template
#
# Copy this file to .env and fill in your values. NEVER commit .env.
#
# The placeholder contract ID and secret key below are format-valid so the
# dry-run quickstart in README.md passes startup validation. They control no
# funds; replace them before running against a real deployment.
#
# Variables marked [hot-reloadable] are re-read before every round by the
# CommonJS components in bot/ (see bot/config.js). Everything else is read
# once at startup.
# ──────────────────────────────────────────────────────────────────────────────

# ── Network and contract ──────────────────────────────────────────────────────

# testnet | futurenet | mainnet
NETWORK=testnet

# Soroban RPC endpoint
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Deployed KeeperRegistry contract ID (C...)
REGISTRY_CONTRACT_ID=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAD2KM

# ── Signing ───────────────────────────────────────────────────────────────────

# Where signing keys come from: env | vault | aws_secrets_manager
SECRET_BACKEND=env

# Single signing account (S...). Required when SECRET_BACKEND=env and
# SIGNING_KEY_POOL is unset. Never logged.
KEEPER_SECRET_KEY=SBGWKM3CD4IL47QN6X54N6Y33T3JDNVI6AIJ6CD5IM47HG3IG4O36XCU

# Optional comma-separated pool of secret keys for concurrent submission.
# Supersedes KEEPER_SECRET_KEY.
# SIGNING_KEY_POOL=S...,S...

# Pool distribution strategy: round-robin | least-loaded
# KEEPER_POOL_STRATEGY=round-robin

# Required for the matching SECRET_BACKEND
# VAULT_ADDR=http://127.0.0.1:8200
# AWS_SECRET_NAME=soroban/keeper/signing-keys

# [restart-required] Evaluate and log decisions without submitting transactions
# DRY_RUN=false

# ── Persistence ───────────────────────────────────────────────────────────────

# PostgreSQL connection string for persistent task state. Leave unset to run
# with in-memory state only. docker-compose.yml builds this from DB_* below.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/keeper_bot_v2

# Used by docker-compose.yml to initialise its PostgreSQL service
DB_USER=keeper
DB_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
DB_NAME=keeper_bot

# ── Rounds and profitability ──────────────────────────────────────────────────

# [hot-reloadable] Delay between rounds, in milliseconds (>= 1000)
POLL_INTERVAL_MS=10000

# Delay before a task rejected by its condition is checked again (>= 1000 ms)
CONDITION_BACKOFF_MS=60000

# [hot-reloadable] Maximum tasks evaluated per round (>= 1)
MAX_TASKS_PER_ROUND=5

# Concurrency within a round. Must not exceed the number of signing accounts.
MAX_CONCURRENT_TASKS=1

# [hot-reloadable] Minimum net profit (stroops) required before claiming
MIN_PROFIT_MARGIN_STROOPS=0

# [hot-reloadable] Auto-withdraw once the balance reaches this many stroops
# (1 XLM = 10,000,000 stroops)
WITHDRAW_THRESHOLD=10000000

# [hot-reloadable] Call expire_task on past-deadline tasks to refund creators
EXPIRE_STALE_TASKS=true

# ── Fees ──────────────────────────────────────────────────────────────────────

# Hard per-round fee ceiling, in stroops
FEE_CEILING_STROOPS=1000000

# Adaptive fee: network fee percentile to target (p10 | p50 | p90 | p99) and
# the multiplier applied to it
FEE_PERCENTILE=p90
FEE_MULTIPLIER=1.1

# ── Retries ───────────────────────────────────────────────────────────────────

# [hot-reloadable] Retries for transient RPC errors, and the exponential
# backoff base delay in milliseconds
MAX_RETRIES=3
RETRY_BASE_MS=500

# ── Observability ─────────────────────────────────────────────────────────────

# Prometheus /metrics endpoint
METRICS_ENABLED=true
METRICS_PORT=9090

# ── Development ───────────────────────────────────────────────────────────────

# [hot-reloadable] DEVELOPMENT ONLY: fabricate proofs for task types with no
# real executor. Never enable against a real deployment.
SIMULATE_EXECUTION=false

# Run a single round then exit (same as the --once flag)
RUN_ONCE=false
