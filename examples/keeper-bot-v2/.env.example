# ──────────────────────────────────────────────────────────────────────────────
# Soroban Keeper Bot v2 — Environment Variables
#
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
#
# Each variable is annotated with its reload behaviour:
#
#   [hot-reloadable]    — Change takes effect within one evaluation round.
#                         No restart needed.
#   [restart-required]  — Change is detected and logged, but takes effect only
#                         after you restart the process.
# ──────────────────────────────────────────────────────────────────────────────

# ── Restart-required ──────────────────────────────────────────────────────────

# [restart-required] Network: testnet | futurenet | mainnet
NETWORK=testnet

# [restart-required] The deployed KeeperRegistry contract ID (starts with C...)
REGISTRY_CONTRACT_ID=CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# [restart-required] Your keeper's Stellar secret key (starts with S...)
# Fund this account on testnet: https://laboratory.stellar.org/#account-creator
KEEPER_SECRET_KEY=SXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# [restart-required] Dry-run mode: evaluate tasks and log decisions without
# submitting any transactions. Signing key is not required in this mode.
# Defaults to false.
# DRY_RUN=false

# ── Hot-reloadable ────────────────────────────────────────────────────────────

# [hot-reloadable] How often to poll for new tasks (milliseconds, integer, >= 1000)
POLL_INTERVAL_MS=10000

# [hot-reloadable] Minimum accumulated rewards before auto-withdrawal (stroops)
# 1 XLM = 10_000_000 stroops. Defaults to 10_000_000.
WITHDRAW_THRESHOLD=10000000

# [hot-reloadable] Maximum tasks to process per poll round (integer, >= 1)
MAX_TASKS_PER_ROUND=5

# [hot-reloadable] Retry policy for transient RPC/network errors
MAX_RETRIES=3
RETRY_BASE_MS=500

# [hot-reloadable] Call expire_task on past-deadline tasks to refund owners.
# Set to false to only spend fees on tasks you can earn rewards from.
EXPIRE_STALE_TASKS=true

# [hot-reloadable] Minimum net profit (stroops) required to claim a task.
# Tasks where (reward − estimated fees) < this threshold are skipped.
# Defaults to 0 (claim anything with a non-negative net return).
MIN_PROFIT_MARGIN_STROOPS=0

# [hot-reloadable] DEVELOPMENT ONLY. When true, fabricates proofs for task
# types with no real executor registered. Never enable against a real
# deployment. Defaults to false.
# SIMULATE_EXECUTION=false
