# ──────────────────────────────────────────────────────────────────────────────
# Soroban Keeper Bot v2 — Environment Variables
#
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
#
# Each variable is annotated with its reload behaviour:
#
#   [hot-reloadable]    — Change takes effect within one evaluation round.
#                         No restart needed.
#   [restart-required]  — Change is detected and logged, but takes effect only
#                         after you restart the process.
# ──────────────────────────────────────────────────────────────────────────────

# ── Restart-required ──────────────────────────────────────────────────────────

# [restart-required] Network: testnet | futurenet | mainnet
NETWORK=testnet

# [restart-required] The deployed KeeperRegistry contract ID (starts with C...)
REGISTRY_CONTRACT_ID=CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# [restart-required] Your keeper's Stellar secret key (starts with S...)
# Fund this account on testnet: https://laboratory.stellar.org/#account-creator
KEEPER_SECRET_KEY=SXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# [restart-required] Dry-run mode: evaluate tasks and log decisions without
# submitting any transactions. Signing key is not required in this mode.
# Defaults to false.
# DRY_RUN=false

# ── Hot-reloadable ────────────────────────────────────────────────────────────

# [hot-reloadable] How often to poll for new tasks (milliseconds, integer, >= 1000)
POLL_INTERVAL_MS=10000

# [hot-reloadable] Minimum accumulated rewards before auto-withdrawal (stroops)
# 1 XLM = 10_000_000 stroops. Defaults to 10_000_000.
WITHDRAW_THRESHOLD=10000000

# [hot-reloadable] Maximum tasks to process per poll round (integer, >= 1)
MAX_TASKS_PER_ROUND=5

# [hot-reloadable] Retry policy for transient RPC/network errors
MAX_RETRIES=3
RETRY_BASE_MS=500

# [hot-reloadable] Call expire_task on past-deadline tasks to refund owners.
# Set to false to only spend fees on tasks you can earn rewards from.
EXPIRE_STALE_TASKS=true

# [hot-reloadable] Minimum net profit (stroops) required to claim a task.
# Tasks where (reward − estimated fees) < this threshold are skipped.
# Defaults to 0 (claim anything with a non-negative net return).
MIN_PROFIT_MARGIN_STROOPS=0

# [hot-reloadable] DEVELOPMENT ONLY. When true, fabricates proofs for task
# types with no real executor registered. Never enable against a real
# deployment. Defaults to false.
# SIMULATE_EXECUTION=false
# Environment configuration for keeper-bot-v2 deployment (docker-compose).
#
# SECURITY: This file contains PLACEHOLDER VALUES only.
# Before deployment:
#   1. Copy this file to .env
#   2. Replace placeholder values with your actual configuration
#   3. Ensure .env is added to .gitignore (NEVER commit real secrets)
#   4. Restrict file permissions: chmod 600 .env
#
# All secrets (KEEPER_SECRET_KEY, DB_PASSWORD) are injected at runtime
# and are never baked into the container image.

# ═══════════════════════════════════════════════════════════════════════════
# REQUIRED: Stellar & Keeper Configuration
# ═══════════════════════════════════════════════════════════════════════════

# Keeper's Stellar account secret key (starts with S).
# How to get:
#   1. Generate a new keypair: https://laboratory.stellar.org/#account-creator
#   2. Create the account on testnet: https://laboratory.stellar.org/#account-creator
#   3. Or use an existing funded account's secret key
# Security: Keep this secret. Never commit to version control.
# Example format: SBVQ7AYDKXQY5MNICBVIIXKB2C2Z4AIDP7YWJJVGFYVYHJSHH7XFBID
KEEPER_SECRET_KEY=SBXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Deployed KeeperRegistry contract ID (starts with C).
# How to get:
#   1. From the deployment outputs when keeper-registry was deployed
#   2. Or query the network: $ soroban contract list --network testnet
# Example format: CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAWHF
REGISTRY_CONTRACT_ID=CAXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Stellar network (testnet, futurenet, or mainnet).
# testnet  — for development/testing (recommended)
# futurenet — for protocol feature testing
# mainnet  — production (real XLM, real stakes)
NETWORK=testnet

# ═══════════════════════════════════════════════════════════════════════════
# REQUIRED: Database Configuration
# ═══════════════════════════════════════════════════════════════════════════

# PostgreSQL database credentials and connection details.
# These are used by the docker-compose service to initialize the database
# and by keeper-bot to connect and persist state.
#
# The DATABASE_URL environment variable in the bot service is auto-constructed as:
#   postgresql://{DB_USER}:{DB_PASSWORD}@postgres:5432/{DB_NAME}
# where 'postgres' is the hostname of the PostgreSQL service within the Docker network.

# Database user (created by PostgreSQL container)
DB_USER=keeper

# Database password (SECRET — keep safe, never commit)
# Generate a strong password: `openssl rand -base64 32`
# Example: bGVhZHNVMktNNGZCMjN5c2tXa2haaWFJN0d5dGdlMTk=
DB_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# Database name (created by PostgreSQL container)
DB_NAME=keeper_bot

# ═══════════════════════════════════════════════════════════════════════════
# OPTIONAL: Keeper Bot Operational Configuration
# ═══════════════════════════════════════════════════════════════════════════

# How often to poll for new tasks (milliseconds).
# Decrease for faster task detection; increase to reduce RPC load.
# Default: 10000 (10 seconds)
POLL_INTERVAL_MS=10000

# Minimum accumulated rewards before automatic withdrawal (stroops).
# 1 XLM = 10,000,000 stroops.
# Set to 0 to disable auto-withdrawal; manage withdrawal manually instead.
# Default: 10000000 (1 XLM)
WITHDRAW_THRESHOLD=10000000

# Maximum tasks to process in a single polling round.
# Prevents resource exhaustion; limits concurrent claims per round.
# Default: 5
MAX_TASKS_PER_ROUND=5

# Retry attempts for transient errors (RPC timeouts, etc).
# Permanent errors (invalid signature, authorization, already claimed) are not retried.
# Default: 3
MAX_RETRIES=3

# Base delay for exponential backoff during retries (milliseconds).
# Actual delay = base * (2 ^ attempt) + random jitter.
# Default: 500
RETRY_BASE_MS=500

# Whether to call expire_task on tasks past their deadline.
# true  — proactively expire stale tasks (reclaim the lock, help the network)
# false — ignore expired tasks (minimize gas spend)
# Default: true
EXPIRE_STALE_TASKS=true

# Minimum profit margin required to claim a task (stroops).
# Only claim tasks where (task.reward - estimated_gas) >= this value.
# Prevents claiming marginally profitable or unprofitable tasks.
# Default: 0 (claim any claimable task)
MIN_PROFIT_MARGIN_STROOPS=0

# ═══════════════════════════════════════════════════════════════════════════
# OPTIONAL: Development Configuration
# ═══════════════════════════════════════════════════════════════════════════

# [DEVELOPMENT ONLY] Simulate task execution without a real executor.
# true  — fabricate synthetic proofs instead of calling the executor
# false — call the registered off-chain executor (or fail if none exists)
# Default: false
# WARNING: Do not enable in production; only for testing without executors.
SIMULATE_EXECUTION=false

# One-shot execution mode (suitable for cron or serverless).
# true  — run a single round then exit with code 0 (success) or 1 (failure)
# false — run continuously in daemon mode, polling every POLL_INTERVAL_MS
# Default: false
RUN_ONCE=false
# Soroban Keeper Network - Keeper Bot v2
# Configuration for adaptive fee submission

# ============================================================================
# Adaptive Fee Configuration
# ============================================================================

# Maximum fee in stroops the operator will ever pay.
# The adaptive fee module will never submit a transaction with a fee exceeding
# this value, regardless of network congestion.
# Recommended: 10000 stroops for normal operations.
# Default: 10000
FEE_CEILING_STROOPS=10000

# Target fee percentile from recent network statistics.
# p10  = Pay more than 10% of recent transactions (ultra-low cost, risky)
# p50  = Pay more than 50% (median fee, moderate inclusion probability)
# p90  = Pay more than 90% (high inclusion probability, recommended)
# p99  = Pay more than 99% (extreme inclusion priority, expensive)
# Default: p90
FEE_PERCENTILE=p90

# Multiplier applied to the selected percentile fee.
# 1.0  = Exact percentile fee from network stats
# 1.1  = 10% above percentile (balance of inclusion and cost)
# 1.5+ = Aggressive fee bumping for high-priority transactions
# Default: 1.1
FEE_MULTIPLIER=1.1

# ============================================================================
# Soroban RPC Configuration
# ============================================================================

# Soroban RPC server URL for querying network conditions and submitting transactions
# Examples:
#   Testnet:  https://soroban-testnet.stellar.org
#   Mainnet:  https://soroban-mainnet.stellar.org
#   Local:    http://localhost:8000
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# ============================================================================
# Network Configuration
# ============================================================================

# Stellar network to target
# Options: testnet, mainnet, standalone
# Default: testnet
NETWORK=testnet

# ============================================================================
# Keeper Configuration (TODO: expand as keeper-bot-v2 features are added)
# ============================================================================

# Stellar account secret key for signing transactions
# Format: A 56-character base32 string starting with S
# WARNING: Never commit this to version control. Use a secrets manager in production.
KEEPER_SECRET_KEY=

# Account ID for the keeper (optional, used for display/validation)
KEEPER_ACCOUNT_ID=

# Maximum concurrent task executions per round
# Default: 1
MAX_CONCURRENT_TASKS=1
# Soroban Keeper Bot v2 Configuration Template

# Network selection: testnet, futurenet, mainnet
NETWORK=testnet

# Deployed KeeperRegistry contract address (C...)
REGISTRY_CONTRACT_ID=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAD2KM

# Secret Management Backend: env, vault, or aws_secrets_manager
SECRET_BACKEND=env

# Single signing account key (starts with S...)
KEEPER_SECRET_KEY=SBGWKM3CD4IL47QN6X54N6Y33T3JDNVI6AIJ6CD5IM47HG3IG4O36XCU

# Optional multi-account signing pool for concurrent transactions (comma-separated secret keys)
# If provided, supersedes KEEPER_SECRET_KEY
# SIGNING_KEY_POOL=SBGWKM3CD4IL47QN6X54N6Y33T3JDNVI6AIJ6CD5IM47HG3IG4O36XCU,SC...

# Vault or AWS Secrets Manager configuration (when SECRET_BACKEND is vault or aws_secrets_manager)
# VAULT_ADDR=http://127.0.0.1:8200
# AWS_SECRET_NAME=soroban/keeper/signing-keys

# Database URL for persistent task state storage (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/keeper_bot_v2

# Concurrency limit within a single round. Must not exceed number of signing accounts in the pool!
MAX_CONCURRENT_TASKS=1

# Maximum tasks evaluated per polling round
MAX_TASKS_PER_ROUND=5

# Polling interval in milliseconds (must be >= 1000)
POLL_INTERVAL_MS=10000

# Minimum profit margin in stroops (1 XLM = 10,000,000 stroops).
MIN_PROFIT_MARGIN_STROOPS=0

# Maximum fee ceiling in stroops (safety ceiling against network fee surges)
FEE_CEILING_STROOPS=1000000

# Minimum accumulated balance before triggering automated withdrawal (in stroops)
WITHDRAW_THRESHOLD=10000000

# Retry configuration for transient errors
MAX_RETRIES=3
RETRY_BASE_MS=500

# Expire stale tasks to refund creators
EXPIRE_STALE_TASKS=true

# Development/testing simulation flag (simulates execution without actual off-chain worker)
SIMULATE_EXECUTION=false

# Metrics endpoint configuration
METRICS_ENABLED=true
METRICS_PORT=9090
