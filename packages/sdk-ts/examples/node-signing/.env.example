# ──────────────────────────────────────────────────────────────
# Node.js secret-key signing example — environment variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# Follows the same convention as examples/keeper-bot/.env.example.
# ──────────────────────────────────────────────────────────────

# Network: testnet | futurenet | mainnet
NETWORK=testnet

# The signer's Stellar secret key (starts with S...). This account submits
# and pays the fee for every transaction this script issues.
# Fund it on testnet: https://laboratory.stellar.org/#account-creator
KEEPER_SECRET_KEY=SXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# The deployed KeeperRegistry contract ID (starts with C...)
REGISTRY_CONTRACT_ID=CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# A task id this script will attempt to claim (must already be registered
# and unclaimed on the target network — see README.md for how to register
# one first if you don't have one to test against).
TASK_ID=1
