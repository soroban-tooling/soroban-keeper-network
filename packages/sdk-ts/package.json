{
  "name": "@soroban-keeper-network/sdk-ts",
  "version": "0.1.0",
  "description": "TypeScript SDK for the Soroban Keeper Network Registry contract",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./client": {
      "import": "./dist/client.js",
      "require": "./dist/client.js",
      "types": "./dist/client.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/**/*.ts"
  },
  "keywords": [
    "soroban",
    "stellar",
    "keeper",
    "registry",
    "typescript",
    "sdk"
  ],
  "license": "Apache-2.0",
  "peerDependencies": {
    "@stellar/stellar-sdk": "^16.0.0"
  },
  "devDependencies": {
    "@stellar/stellar-sdk": "^16.2.0",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.55.0",
    "typescript": "^5.3.3",
    "vitest": "^1.0.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
