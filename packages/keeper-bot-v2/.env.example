# Soroban Keeper Network — v2 Configuration Example
#
# Copy this file to .env and fill in your own values.

# Network to connect to: testnet, futurenet, or mainnet
NETWORK=testnet

# Contract ID of the KeeperRegistry on the chosen network
# Must start with C...
REGISTRY_CONTRACT_ID=C...

# Your keeper's secret key (starts with S...)
# NEVER commit this to version control
KEEPER_SECRET_KEY=S...

# Optional: polling interval in milliseconds (default: 10000)
POLL_INTERVAL_MS=10000

# Optional: minimum balance (in stroops) to accumulate before withdrawing (default: 10000000)
WITHDRAW_THRESHOLD=10000000

# Optional: maximum tasks to process per round (default: 5)
MAX_TASKS_PER_ROUND=5

# Optional: maximum retry attempts for transient RPC errors (default: 3)
MAX_RETRIES=3

# Optional: base delay (in ms) for exponential backoff retry (default: 500)
RETRY_BASE_MS=500

# Optional: whether to expire stale tasks after their deadline (default: true)
EXPIRE_STALE_TASKS=true

# Optional: minimum profit margin in stroops for claiming a task (default: 0)
# Task is skipped if: reward - estimated_gas_fee - margin < 0
MIN_PROFIT_MARGIN_STROOPS=0

# Optional: path to persistent state database (default: ./keeper-state.db)
# This is where task outcomes and skip decisions are stored
STATE_DB_PATH=./keeper-state.db

# Optional: development only — simulate execution instead of calling actual executors (default: false)
# NEVER enable in production: a keeper that fabricates proofs violates the trust model
SIMULATE_EXECUTION=false

# ──────────────────────────────────────────────────────────────────────────────
# Indexer integration (optional — enables indexer-backed task discovery)
#
# When both INDEXER_WS_URL and INDEXER_REST_URL are set the bot subscribes to
# the indexer WebSocket feed for new TaskRegistered events instead of scanning
# getEvents directly. This removes lookback-window edge cases and reduces RPC
# load across keepers.
#
# The authoritative on-chain is_claimable check is still performed before every
# claim regardless of which source is active (issue #0034). Indexer data is used
# only for candidate discovery — the chain is always the claimability authority.
#
# When either URL is absent the bot falls back to direct RPC event scanning,
# preserving standalone operation without an indexer deployment.
# ──────────────────────────────────────────────────────────────────────────────

# WebSocket endpoint for the indexer's live event feed (must start with ws:// or wss://)
# Example: ws://localhost:8080/v1/ws
# INDEXER_WS_URL=

# REST base URL for the indexer API (must start with http:// or https://)
# Example: http://localhost:8080/v1
# INDEXER_REST_URL=
