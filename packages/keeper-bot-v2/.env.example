# Keeper Network Configuration
NETWORK=testnet
REGISTRY_CONTRACT_ID=
KEEPER_SECRET_KEY=

# Retry and polling configuration
MAX_RETRIES=3
RETRY_BASE_MS=500
POLL_INTERVAL_MS=10000

# Degraded mode configuration (for extended RPC outages)
CONSECUTIVE_EXHAUSTED_RETRIES_FOR_DEGRADED_MODE=3
DEGRADED_MODE_POLLING_INTERVAL_MS=60000

# Other options
MAX_TASKS_PER_ROUND=5
WITHDRAW_THRESHOLD=10000000
MIN_PROFIT_MARGIN_STROOPS=0
EXPIRE_STALE_TASKS=true
